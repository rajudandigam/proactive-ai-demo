# Decision provider: fixture (default, no API key) or live (OpenAI Structured Outputs)
DECISION_PROVIDER=fixture

# Required only when DECISION_PROVIDER=live
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-2024-08-06

# Model call timeout in milliseconds (one attempt per intake)
OPENAI_TIMEOUT_MS=15000

# Server bind (localhost only)
HOST=127.0.0.1
PORT=3000
