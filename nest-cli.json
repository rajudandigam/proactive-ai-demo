{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "../fixtures/**/*",
        "outDir": "dist/fixtures",
        "watchAssets": false
      },
      {
        "include": "../skills/**/*",
        "outDir": "dist/skills",
        "watchAssets": false
      },
      {
        "include": "../public/**/*",
        "outDir": "dist/public",
        "watchAssets": false
      },
      {
        "include": "../docs/architecture/**/*",
        "outDir": "dist/docs/architecture",
        "watchAssets": false
      }
    ]
  }
}
