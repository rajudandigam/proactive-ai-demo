{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["scripts/lab/**/*.ts", "src/playground/**/*.ts", "src/workloads/**/*.ts", "src/providers/**/*.ts", "src/instrumentation/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
